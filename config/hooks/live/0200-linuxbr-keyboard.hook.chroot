#!/bin/sh
# Set image defaults before initramfs and rootfs validation. live-config boot
# arguments remain in place; Calamares may replace these with the user's choice.
set -eu
# Make the base filesystem Brazilian as well as the live boot session.
# Calamares may replace this locale with the user's installation choice.
sed -i 's/^# *pt_BR.UTF-8 UTF-8/pt_BR.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
update-locale LANG=pt_BR.UTF-8
# New users inherit the distribution avatar; existing account images stay intact.
if [ -f /usr/share/icons/hicolor/512x512/apps/linuxbr.png ]; then
    install -m 0644 /usr/share/icons/hicolor/512x512/apps/linuxbr.png /etc/skel/.face
fi
cat > /etc/default/keyboard <<'KEYBOARD'
XKBMODEL="pc105"
XKBLAYOUT="br"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
KEYBOARD
mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<'XORG'
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "br"
    Option "XkbModel" "pc105"
    Option "XkbVariant" ""
EndSection
XORG
setupcon --save-only
# Include the configured console keymap in each already-installed kernel.
update-initramfs -u -k all
