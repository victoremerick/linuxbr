#!/bin/sh
# Keep 32-bit compatibility available after Calamares copies the live filesystem.
set -eu
export DEBIAN_FRONTEND=noninteractive
dpkg --add-architecture i386
apt-get update
# libwine recommends media/peripheral libraries, but --no-install-recommends
# omits them. An amd64 desktop codec cannot decode video inside an i386 process.
apt-get install -y --no-install-recommends \
    wine wine64 wine32:i386 fonts-wine winetricks cabextract \
    steam-installer steam-devices \
    mesa-vulkan-drivers:amd64 mesa-vulkan-drivers:i386 \
    libvulkan1:amd64 libvulkan1:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386 \
    libpulse0:i386 libasound2-plugins:i386 vulkan-tools mesa-utils \
    gstreamer1.0-plugins-good:i386 gstreamer1.0-plugins-bad:i386 \
    gstreamer1.0-plugins-ugly:i386 gstreamer1.0-libav:i386 \
    libcups2t64:i386 libsdl2-2.0-0:i386 libv4l-0t64:i386
