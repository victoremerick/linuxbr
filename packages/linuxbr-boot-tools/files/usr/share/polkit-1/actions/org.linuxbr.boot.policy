<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Linux BR</vendor>
  <action id="org.linuxbr.boot.recovery">
    <description>Selecionar manutenção autenticada na próxima inicialização</description>
    <message>Uma sessão local ativa é necessária para selecionar a manutenção.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>
</policyconfig>
