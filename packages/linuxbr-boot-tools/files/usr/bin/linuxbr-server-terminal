#!/bin/sh
set -eu
mode=${1:-window}
case "$mode" in
    shell|window)
        if [ -z "${DISPLAY:-}" ] || ! /usr/bin/xset q >/dev/null 2>&1; then
            printf 'Abra a sessão gráfica do Linux BR VM Server para criar outra janela.\n' >&2
            exit 1
        fi
        if [ "$mode" = shell ]; then
            exec /usr/bin/xterm -name linuxbr-server-shell -T 'Terminal — Linux BR' \
                -fa monospace -fs 12 -geometry 88x26 -bg '#000000' -fg '#f2f2f2' \
                -e /bin/bash --login
        fi
        /usr/bin/nohup /usr/bin/xterm -name linuxbr-server-window -T 'Terminal — Linux BR' \
            -fa monospace -fs 12 -geometry 88x26 -bg '#000000' -fg '#f2f2f2' \
            -e /bin/bash --login </dev/null >/dev/null 2>&1 &
        exit 0
        ;;
    configuration)
        exec /usr/bin/xterm -name linuxbr-server-configuration -T 'Configuração do servidor — Linux BR' \
            -fa monospace -fs 12 -geometry 88x26 -bg '#4f5b66' -fg '#ffffff' -cr '#fff091' \
            -e /usr/bin/linuxbr-console --janela
        ;;
esac
exit 2
