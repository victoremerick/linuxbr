[Unit]
Description=Consume Linux BR temporary boot selection
After=local-fs.target
Before=display-manager.service getty.target
ConditionPathExists=/boot/grub/grubenv

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/linuxbr-boot/boot_backend.py --consume

[Install]
WantedBy=multi-user.target linuxbr-safe.target
