[Unit]
Description=Linux BR — letras de unidades e locais do Dolphin
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=dbus
BusName=org.linuxbr.DriveManager1
ExecStart=/usr/bin/linuxbr-drive-service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
