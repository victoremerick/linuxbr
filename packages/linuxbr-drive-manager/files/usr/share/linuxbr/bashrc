# Shared interactive profile for desktop, server and maintenance terminals.
case " $(</proc/cmdline) " in
    *" linuxbr.mode=safe "*|*" linuxbr.mode=safe-network "*|*" linuxbr.mode=safe-terminal "*|*" linuxbr.mode=recovery "*) ;;
    *) [[ -f ~/.bashrc ]] && source ~/.bashrc ;;
esac
[[ $- == *i* ]] || return
source /usr/share/linuxbr/terminal.bash
