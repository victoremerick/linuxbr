#!/usr/bin/python3
"""Initialize missing account defaults without rewriting personal preferences."""
import os
from pathlib import Path
import shutil
import subprocess


if os.geteuid() == 0:
    raise SystemExit('Execute na sessão do usuário, sem sudo.')

config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config')))
subprocess.run(['/usr/bin/python3', '/usr/lib/linuxbr-desktop/keyboard-defaults.py'], check=True)

notification = config/'plasmanotifyrc'
if not notification.exists():
    notification.parent.mkdir(parents=True, exist_ok=True)
    try:
        with notification.open('x', encoding='utf-8') as stream:
            stream.write(Path('/etc/skel/.config/plasmanotifyrc').read_text(encoding='utf-8'))
    except FileExistsError:
        pass

# This marker is copied only when a new home is created from /etc/skel.
# Package upgrades must never repin programs, recreate removed desktop links,
# change floating panels, or overwrite a user's theme and window buttons.
marker = config/'linuxbr/desktop-first-login'
if marker.is_file() and not marker.is_symlink():
    if shutil.which('xdg-user-dirs-update'):
        subprocess.run(['xdg-user-dirs-update'], check=False, timeout=15)
    if shutil.which('xdg-user-dir'):
        try:
            desktop_name = subprocess.check_output(['xdg-user-dir', 'DESKTOP'], text=True, timeout=5).strip()
            desktop = Path(desktop_name)
            home = Path.home().resolve()
            # A disabled Desktop is represented by HOME. Do not put icons there.
            if desktop.is_absolute() and desktop.resolve() != home and desktop.resolve().is_relative_to(home):
                desktop.mkdir(parents=True, exist_ok=True)
                links = (
                    ('Arquivos pessoais.desktop', 'Arquivos pessoais', 'user-home', home.as_uri(), 'Documentos, downloads, imagens e seus arquivos'),
                    ('Lixeira.desktop', 'Lixeira', 'user-trash', 'trash:/', 'Restaurar ou remover arquivos descartados'),
                )
                for filename, title, icon, url, comment in links:
                    destination = desktop/filename
                    try:
                        with destination.open('x', encoding='utf-8') as stream:
                            stream.write('[Desktop Entry]\nType=Link\nName='+title+'\nComment='+comment+'\nIcon='+icon+'\nURL='+url+'\n')
                    except FileExistsError:
                        continue
            marker.unlink()
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            # Leave the marker for a later session if XDG folders are not ready.
            print('Linux BR: não foi possível preparar os atalhos iniciais: '+str(error))
