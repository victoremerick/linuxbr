+        if (auto *apply = button(QDialogButtonBox::Apply)) apply->setEnabled(true);
         Q_EMIT applied();
+        if (applyOnly) {
+            return;
+        }
         Q_EMIT propertiesClosed();
         deleteLater(); // Somewhat like Qt::WA_DeleteOnClose would do.
