# Quiet loading screen: logo and continuously animated indicator.
Window.SetBackgroundTopColor(0.063, 0.098, 0.122);
Window.SetBackgroundBottomColor(0.063, 0.098, 0.122);
logo_image = Image("logo.png");
logo = Sprite(logo_image);
logo.SetPosition(Window.GetX() + (Window.GetWidth() - logo_image.GetWidth()) / 2,
                 Window.GetY() + Window.GetHeight() * 0.36 - logo_image.GetHeight() / 2, 0);
title_image = Image.Text("Linux BR", 0.90, 0.92, 0.93);
title = Sprite(title_image);
title.SetPosition(Window.GetX() + (Window.GetWidth() - title_image.GetWidth()) / 2,
                  Window.GetY() + Window.GetHeight() * 0.36 + logo_image.GetHeight() / 2 + 12, 0);
for (i = 0; i < 12; i++) frames[i] = Image("spinner-" + i + ".png");
spinner = Sprite(frames[0]);
spinner.SetPosition(Window.GetX() + (Window.GetWidth() - 64) / 2,
                    Window.GetY() + Window.GetHeight() * 0.64 - 32, 0);
frame = 0;
ticks = 0;
fun refresh() {
    global.ticks++;
    if (ticks >= 5) {
        global.ticks = 0;
        global.frame++;
        if (frame >= 12) global.frame = 0;
        spinner.SetImage(frames[frame]);
    }
}
Plymouth.SetRefreshFunction(refresh);
prompt_label = Sprite();
answer_label = Sprite();
fun text_at(sprite, text, fraction) {
    image = Image.Text(text, 1, 1, 1);
    sprite.SetImage(image);
    sprite.SetPosition(Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2,
                       Window.GetY() + fraction * Window.GetHeight(), 100);
}
fun normal() {
    prompt_label.SetOpacity(0);
    answer_label.SetOpacity(0);
}
fun password(prompt, bullets) {
    text_at(prompt_label, prompt, 0.72);
    stars = "";
    # Keep long passwords inside the display; never show the password itself.
    for (i = 0; i < bullets && i < 32; i++) stars += "*";
    text_at(answer_label, stars, 0.79);
    prompt_label.SetOpacity(1);
    answer_label.SetOpacity(1);
}
fun question(prompt, entry) {
    text_at(prompt_label, prompt, 0.72);
    text_at(answer_label, entry, 0.79);
    prompt_label.SetOpacity(1);
    answer_label.SetOpacity(1);
}
# Routine status messages stay out of the graphical loading screen.
fun message(text) { }
fun hide_message(text) { }
Plymouth.SetDisplayNormalFunction(normal);
Plymouth.SetDisplayPasswordFunction(password);
Plymouth.SetDisplayQuestionFunction(question);
Plymouth.SetDisplayMessageFunction(message);
Plymouth.SetHideMessageFunction(hide_message);
