#!/bin/sh
set -eu
case "$1" in
    remove|purge)
        rm -f /var/lib/linuxbr-boot-theme/previous-theme
        if [ -d /var/lib/linuxbr-boot-theme ]; then rmdir --ignore-fail-on-non-empty /var/lib/linuxbr-boot-theme; fi
        if command -v update-initramfs >/dev/null 2>&1; then dpkg-trigger --no-await update-initramfs; fi
        # Conffiles remain on remove: the GRUB fragment guards its theme path.
        if [ -f /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then update-grub; fi
        ;;
esac
