[Desktop Entry]
Type=Application
Name=Cofre de credenciais Linux BR
Comment=Preparar o armazenamento seguro para entrar nos aplicativos
Exec=linuxbr-credentials --prepare-session
TryExec=/usr/bin/linuxbr-credentials
Icon=wallet-open
OnlyShowIn=KDE;
NoDisplay=true
X-KDE-autostart-phase=2
X-KDE-autostart-after=panel
