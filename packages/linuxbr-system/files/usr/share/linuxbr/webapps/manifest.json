{
  "manifest_version": 3,
  "name": "Aplicativos web Linux BR",
  "version": "0.8.0.1",
  "description": "Sugestões locais para usar sites como aplicativos no Linux BR.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "startup-worker-081.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aplicativos web Linux BR",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "incognito": "not_allowed",
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
