[Desktop Entry]
Type=Service
MimeType=application/octet-stream;inode/directory;
Actions=shortcut;
X-KDE-Protocols=file,smb,linuxbr
X-KDE-RequiredNumberOfUrls=1
X-KDE-Priority=TopLevel

[Desktop Action shortcut]
Name=Criar atalho…
Icon=emblem-symbolic-link
Exec=/usr/bin/linuxbr-file-tools --shortcut %u
