[Desktop Entry]
Type=Application
Name=Desbloquear credenciais e senhas
Comment=Desbloquear o cofre seguro para entrar nos aplicativos
Exec=linuxbr-credentials --unlock
TryExec=/usr/bin/linuxbr-credentials
Icon=wallet-open
Terminal=false
Categories=Settings;Security;
Keywords=credenciais;senhas;cofre;login;Office;Microsoft;
