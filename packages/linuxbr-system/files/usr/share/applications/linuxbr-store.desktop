[Desktop Entry]
Type=Application
Name=Loja de aplicativos
Comment=Programas Linux, aplicativos web e programas Windows com Wine
Exec=linuxbr-store
Icon=system-software-install
Terminal=false
Categories=System;PackageManager;
Keywords=loja;instalar;programas;aplicativos;Windows;Wine;web;baixar;
StartupWMClass=linuxbr-store

Actions=Installed;Updates;

[Desktop Action Installed]
Name=Meus aplicativos
Exec=linuxbr-store --installed

[Desktop Action Updates]
Name=Atualizações
Exec=linuxbr-store --updates
