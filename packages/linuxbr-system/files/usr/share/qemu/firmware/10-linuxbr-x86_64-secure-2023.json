{
  "description": "Linux BR UEFI x86_64 \u2014 Secure Boot com autoridades Microsoft 2011 e 2023",
  "interface-types": ["uefi"],
  "mapping": {
    "device": "flash",
    "executable": {"filename": "/usr/share/OVMF/OVMF_CODE_4M.ms.fd", "format": "raw"},
    "nvram-template": {"filename": "/var/lib/linuxbr/firmware/OVMF_VARS_4M.ms-2023.fd", "format": "raw"}
  },
  "targets": [{"architecture": "x86_64", "machines": ["pc-q35-*"]}],
  "features": ["acpi-s3", "amd-sev", "enrolled-keys", "requires-smm", "secure-boot", "verbose-dynamic"],
  "tags": ["linuxbr", "microsoft-ca-2023"]
}
