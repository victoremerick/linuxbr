<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Linux BR</vendor>
  <action id="org.linuxbr.recovery-keys.verify">
    <description>Verificar frase de recuperação LUKS</description>
    <message>Confirme a autorização para testar a frase de recuperação do volume</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/linuxbr-system/recovery_keys.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--verify</annotate>
  </action>
</policyconfig>
