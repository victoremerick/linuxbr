<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Linux BR</vendor>
  <action id="org.linuxbr.support.diagnostic">
    <description>Consultar ou enviar um diagnóstico para a organização</description>
    <message>Confirme sua identidade para usar o suporte da organização</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/linuxbr-system/support_remote.py</annotate>
  </action>
</policyconfig>
