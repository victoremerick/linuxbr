[Unit]
Description=Configuração inicial do Linux BR Desktop
Wants=NetworkManager.service
After=local-fs.target NetworkManager.service
Before=sddm.service

[Service]
Type=notify
ExecStart=/usr/bin/python3 /usr/lib/linuxbr-system/initial_setup_service.py
Restart=on-failure
RestartSec=2s
RemainAfterExit=yes
RuntimeDirectory=linuxbr-initial-setup
RuntimeDirectoryMode=0755
UMask=0077

